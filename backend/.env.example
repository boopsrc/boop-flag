# Porta do servidor HTTP
PORT=8080

# String de conexão com o Postgres (bate com o docker-compose.yml da raiz)
DATABASE_URL=postgres://boop:boop@localhost:5432/boopflag?sslmode=disable

# Origem do frontend (usada em CORS e nos redirects pós-login)
FRONTEND_URL=http://localhost:5173

# Credenciais OAuth do Google (crie em https://console.cloud.google.com/apis/credentials)
# Necessárias quando AUTH_DEV_MODE=false.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Segredo para assinar os JWTs de sessão e o state OAuth. Gere um valor longo e
# aleatório, ex.: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Duração da sessão
SESSION_TTL=24h

# Modo dev: habilita um login mock (/api/v1/auth/dev/login) que dispensa o
# Google. Deixe true para testar sem credenciais; NUNCA use true em produção.
AUTH_DEV_MODE=true
